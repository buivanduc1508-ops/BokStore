<%@ page import="java.util.*,model.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%Book b=(Book)request.getAttribute("book");List<Category> cats=(List<Category>)request.getAttribute("categories");%><div class="bok-admin"><header><div><p>BOKSTORE</p><h1><%=b==null?"Thêm sản phẩm":"Chỉnh sửa sản phẩm"%></h1></div><a href="<%=request.getContextPath()%>/admin/manage?tab=books">Quay lại</a></header><section class="admin-form-card"><form class="form-grid" method="post" action="<%=request.getContextPath()%>/admin/manage"><input type="hidden" name="tab" value="books"><input type="hidden" name="type" value="book"><input type="hidden" name="id" value="<%=b==null?0:b.getId()%>"><label>Tên sách<input name="name" required value="<%=b==null?"":b.getName()%>"></label><label>Tác giả<input name="author" required value="<%=b==null?"":b.getAuthor()%>"></label><label>Nhà xuất bản<input name="publisher" required value="<%=b==null?"":b.getPublisher()%>"></label><label>Giá bán<input name="price" type="number" min="0" required value="<%=b==null?0:b.getPrice()%>"></label><label>Tồn kho<input name="stock" type="number" min="0" required value="<%=b==null?0:b.getStock()%>"></label><label>Danh mục<select name="categoryId"><%for(Category c:cats){%><option value="<%=c.getId()%>" <%=b!=null&&b.getCategoryId()==c.getId()?"selected":""%>><%=c.getName()%></option><%}%></select></label><label>Đường dẫn ảnh<input name="image" value="<%=b==null?"":b.getImage()%>"></label><label>Mô tả<textarea name="description" required><%=b==null?"":b.getDescription()%></textarea></label><button>Lưu sản phẩm</button></form><%if(b!=null){%><hr><form class="inline-form" method="post" action="<%=request.getContextPath()%>/admin/manage"><input type="hidden" name="tab" value="books"><input type="hidden" name="type" value="book"><input type="hidden" name="action" value="stock"><input type="hidden" name="id" value="<%=b.getId()%>"><input name="quantity" type="number" min="1" required placeholder="Số lượng nhập thêm"><button>Nhập thêm kho</button></form><%}%></section></div>
