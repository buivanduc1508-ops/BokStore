<%@ page import="model.User" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%User u=(User)session.getAttribute("user");%><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/bokstore.css"><section class="container content-section auth-grid"><form method="post"><h1>Thông tin cá nhân</h1><input name="name" value="<%=u.getName()%>" required><input name="email" value="<%=u.getEmail()%>" required><input name="phone" value="<%=u.getPhone()%>"><input name="address" value="<%=u.getAddress()%>"><button>Lưu</button></form><form method="post"><input type="hidden" name="action" value="password"><h2>Đổi mật khẩu</h2><input type="password" name="oldPassword" required placeholder="Mật khẩu hiện tại"><input type="password" name="password" required placeholder="Mật khẩu mới"><button>Đổi mật khẩu</button></form></section>
