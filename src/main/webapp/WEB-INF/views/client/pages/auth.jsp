<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/bokstore.css"><section class="container content-section auth-grid"><form method="post" action="${pageContext.request.contextPath}/login"><h1>Đăng nhập</h1><p class="error">${error}</p><input name="account" required placeholder="Email/SĐT/Tên đăng nhập"><input name="password" required type="password" placeholder="Mật khẩu"><button>Đăng nhập</button><small>Demo: admin/admin123 hoặc user/user123</small></form><form method="post" action="${pageContext.request.contextPath}/register"><h2>Đăng ký</h2><input name="name" required placeholder="Họ tên"><input name="email" type="email" required placeholder="Email"><input name="phone" placeholder="Số điện thoại"><input name="address" placeholder="Địa chỉ"><input name="username" required placeholder="Tên đăng nhập"><input name="password" required type="password" placeholder="Mật khẩu"><button>Tạo tài khoản</button></form></section>
