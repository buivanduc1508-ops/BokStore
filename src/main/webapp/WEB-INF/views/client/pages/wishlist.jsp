<%@ page import="java.util.*,model.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%List<Book> books=(List<Book>)request.getAttribute("books");%><section class="container content-section"><h1>Sách yêu thích</h1><div class="book-grid"><%for(Book b:books){%><article class="book-card"><a class="cover-link" href="<%=request.getContextPath()%>/book?id=<%=b.getId()%>"><div class="book-cover cover-1"><strong><%=b.getName().substring(0,1)%></strong></div></a><div class="book-info"><h3><a href="<%=request.getContextPath()%>/book?id=<%=b.getId()%>"><%=b.getName()%></a></h3><p><%=b.getAuthor()%></p><strong><%=String.format("%,d",b.getPrice())%> đ</strong><form method="post" action="<%=request.getContextPath()%>/favorite"><input type="hidden" name="id" value="<%=b.getId()%>"><input type="hidden" name="returnTo" value="/wishlist"><button class="wishlist-btn">Bỏ yêu thích</button></form></div></article><%}%></div><%if(books.isEmpty()){%><p>Danh sách yêu thích đang trống.</p><%}%></section>
