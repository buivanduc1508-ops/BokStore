<%@ page import="java.util.*,model.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%List<Order> os=(List<Order>)request.getAttribute("orders");%><section class="container content-section"><h1>Lịch sử mua hàng</h1><div class="table-wrap"><table><tr><th>Mã</th><th>Ngày đặt</th><th>Người nhận</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr><%for(Order o:os){%><tr><td>#<%=o.getId()%></td><td><%=o.getCreated().toLocalDate()%></td><td><%=o.getCustomer()%></td><td><%=String.format("%,d",o.getTotal())%> đ</td><td><span class="stock"><%=o.getStatus()%></span></td><td><div class="action-links"><a href="<%=request.getContextPath()%>/order-detail?id=<%=o.getId()%>">Chi tiết</a><%if("PENDING".equals(o.getStatus())){%><form method="post"><input type="hidden" name="id" value="<%=o.getId()%>"><button>Hủy đơn</button></form><%}%></div></td></tr><%}%></table></div><%if(os.isEmpty()){%><p>Bạn chưa có đơn hàng nào. <a href="<%=request.getContextPath()%>/shop">Mua sách ngay</a>.</p><%}%></section>
